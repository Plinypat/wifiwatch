# RuView ESP32 firmware defaults
# These can be overridden via menuconfig or provisioning

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BUFFER=64

# Increase NVS partition size for provisioning data
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WebSocket / HTTP client
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_WEBSOCKET_URI_FROM_STDIN=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000

# WiFi task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# CSI (Channel State Information) — required for sensing
CONFIG_ESP_WIFI_CSI_ENABLED=y
